# Copy this file to .env and fill it in. Never commit .env.

# Secret used to sign login tokens. Use 32 or more random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional: use the real Stripe TEST API instead of the built-in sandbox.
# Must start with sk_test_ (live keys are refused).
STRIPE_SECRET_KEY=

PORT=3000
